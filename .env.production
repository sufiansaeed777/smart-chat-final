# This file tells Next.js to use Amplify environment variables at runtime
# The actual values come from Amplify Environment Variables

DATABASE_URL=${DATABASE_URL}
DIRECT_URL=${DIRECT_URL}
NEXTAUTH_SECRET=${NEXTAUTH_SECRET}
NEXTAUTH_URL=${NEXTAUTH_URL}
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
OPENAI_API_KEY=${OPENAI_API_KEY}
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=${NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY}
EMAIL_USER=${EMAIL_USER}
EMAIL_APP_PASSWORD=${EMAIL_APP_PASSWORD}
N8N_WEBHOOK_URL=${N8N_WEBHOOK_URL}
USE_IP_WORKAROUND=${USE_IP_WORKAROUND}
RESEND_API_KEY=${RESEND_API_KEY}
NEXT_PUBLIC_BASE_URL=${NEXTAUTH_URL}
NEXT_PUBLIC_APP_URL=${NEXTAUTH_URL}
