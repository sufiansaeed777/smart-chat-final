#
# PHASE 4: Terraform Variables Example
# Copy this file to terraform.tfvars and fill in your values
#

# AWS Configuration
aws_region   = "us-east-1"
project_name = "smart-chat"
environment  = "production"

# Network Configuration
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]

# EC2 Configuration
instance_type = "t3.medium"
key_pair_name = "your-ssh-key-name" # Create this in AWS EC2 console first

# Auto Scaling Configuration
asg_min_size         = 1
asg_max_size         = 4
asg_desired_capacity = 2

# RDS Configuration
db_instance_class           = "db.t3.micro"
db_name                     = "smart_chat"
db_username                 = "postgres"
db_password                 = "CHANGE_ME_STRONG_PASSWORD" # Use a strong password
db_allocated_storage        = 20
db_backup_retention_period  = 7

# ElastiCache Redis Configuration
redis_node_type       = "cache.t3.micro"
redis_num_cache_nodes = 1

# S3 Configuration
s3_bucket_name = "smart-chat-storage-YOUR_ACCOUNT_ID" # Must be globally unique

# Application Configuration
nextauth_secret      = "CHANGE_ME_GENERATE_RANDOM_SECRET" # Generate with: openssl rand -base64 32
nextauth_url         = "https://yourdomain.com"
openai_api_key       = "sk-..."
stripe_secret_key    = "sk_live_..."
stripe_webhook_secret = "whsec_..."

# Monitoring Configuration
enable_cloudwatch_alarms = true
alarm_email              = "admin@yourdomain.com"

# Tags
tags = {
  Project     = "Smart Chat"
  ManagedBy   = "Terraform"
  CostCenter  = "Engineering"
}
